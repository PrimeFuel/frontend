@startuml Inventory BC

skinparam backgroundColor #FAFAFA
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #555555
skinparam classHeaderBackgroundColor #2C3E50
skinparam classFontColor White
skinparam ArrowColor #2C3E50
skinparam linetype ortho

package "inventory.domain" #D6E4F0 {
  interface BaseEntity {
    +id: string
  }

  class FuelProduct {
    +id: string
    +name: string
    +type: string
    +description: string
    +pricePerLiter: number
    +unit: string
    +isActive: boolean
    +createdAt: string
  }

  class InventoryItem {
    +id: string
    +productId: string
    +providerId: string
    +availableQuantity: number
    +reservedQuantity: number
    +unit: string
    +lastUpdated: string
  }

  interface CreateProductPayload {
    +name: string
    +type: string
    +description: string
    +pricePerLiter: number
    +unit: string
  }

  interface UpdateProductPayload {
    +name?: string
    +type?: string
    +pricePerLiter?: number
    +unit?: string
    +isActive?: boolean
  }

  interface UpdateStockPayload {
    +availableQuantity: number
  }

  interface ReserveStockPayload {
    +quantityToReserve: number
  }

  FuelProduct .up.|> BaseEntity
  InventoryItem .up.|> BaseEntity
}

package "inventory.application" #FFF9E6 {
  class InventoryStore {
    -_productList: Signal<FuelProduct[]>
    -_selectedProduct: Signal<FuelProduct | null>
    -_inventoryList: Signal<InventoryItem[]>
    -_isLoading: Signal<boolean>
    -_error: Signal<string | null>
    +productList: Signal<FuelProduct[]>
    +inventoryList: Signal<InventoryItem[]>
    +activeProducts: Signal<FuelProduct[]>
    +dieselProducts: Signal<FuelProduct[]>
    +gasolineProducts: Signal<FuelProduct[]>
    +lowStockItems: Signal<InventoryItem[]>
    +loadAllProducts(): void
    +createProduct(payload: CreateProductPayload): void
    +updateProduct(id: string, payload: UpdateProductPayload): void
    +deleteProduct(id: string): void
    +loadInventory(): void
    +updateStock(id: string, payload: UpdateStockPayload): void
  }
}

package "inventory.infrastructure" #D6EAD6 {
  abstract class BaseApi {}
  abstract class BaseApiEndpoint {}

  class InventoryApi {
    -_productEndpoint: ProductApiEndpoint
    -_inventoryEndpoint: InventoryApiEndpoint
    +getProducts(): Observable<FuelProduct[]>
    +createProduct(payload): Observable<FuelProduct>
    +updateProduct(id, payload): Observable<FuelProduct>
    +deleteProduct(id): Observable<void>
    +getInventory(): Observable<InventoryItem[]>
    +updateStock(id, payload): Observable<InventoryItem>
  }

  class ProductApiEndpoint {
    +getActiveProducts(): Observable<FuelProduct[]>
    +getProductsByType(type: string): Observable<FuelProduct[]>
    +createWithPayload(payload): Observable<FuelProduct>
    +updateWithPayload(id, payload): Observable<FuelProduct>
  }

  class InventoryApiEndpoint {
    +getByProvider(providerId: string): Observable<InventoryItem[]>
    +updateStock(id, payload): Observable<InventoryItem>
    +reserveStock(id, payload): Observable<InventoryItem>
  }

  class ProductAssembler {
    +toEntityFromResource(resource): FuelProduct
    +toResourceFromEntity(entity): ProductResource
    +toEntitiesFromResponse(response): FuelProduct[]
  }

  class InventoryAssembler {
    +toEntityFromResource(resource): InventoryItem
    +toResourceFromEntity(entity): InventoryResource
    +toEntitiesFromResponse(response): InventoryItem[]
  }

  InventoryApi -up-|> BaseApi
  ProductApiEndpoint -up-|> BaseApiEndpoint
  InventoryApiEndpoint -up-|> BaseApiEndpoint
  ProductApiEndpoint *-- ProductAssembler
  InventoryApiEndpoint *-- InventoryAssembler
  InventoryApi *-- ProductApiEndpoint
  InventoryApi *-- InventoryApiEndpoint
}

package "inventory.presentation" #F7E6D6 {
  class ProductInventoryComponent {
    -store: InventoryStore
  }
  class ProductFormComponent {
    -store: InventoryStore
    +form: FormGroup
    +isEditMode: boolean
  }
  class InventoryListComponent {
    -store: InventoryStore
    +filterProviderId: string
  }
}

InventoryStore --> InventoryApi : injects
ProductInventoryComponent --> InventoryStore : injects
ProductFormComponent --> InventoryStore : injects
InventoryListComponent --> InventoryStore : injects

@enduml
