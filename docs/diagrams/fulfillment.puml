@startuml Fulfillment BC

skinparam backgroundColor #FAFAFA
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #555555
skinparam classHeaderBackgroundColor #2C3E50
skinparam classFontColor White
skinparam ArrowColor #2C3E50
skinparam linetype ortho

package "fulfillment.domain" #D6E4F0 {
  interface BaseEntity {
    +id: string
  }

  class Vehicle {
    +id: string
    +providerId: string
    +licensePlate: string
    +model: string
    +brand: string
    +capacity: number
    +unit: string
    +status: string
    +createdAt: string
  }

  class Driver {
    +id: string
    +providerId: string
    +firstName: string
    +lastName: string
    +licenseNumber: string
    +phoneNumber: string
    +email: string
    +status: string
    +createdAt: string
  }

  class Delivery {
    +id: string
    +orderId: string
    +vehicleId: string
    +driverId: string
    +status: string
    +scheduledDate: string
    +actualDeliveryDate: string | null
    +notes: string
    +createdAt: string
  }

  Vehicle .up.|> BaseEntity
  Driver .up.|> BaseEntity
  Delivery .up.|> BaseEntity
  Delivery ..> Vehicle : references (vehicleId)
  Delivery ..> Driver : references (driverId)
}

package "fulfillment.application" #FFF9E6 {
  class FulfillmentStore {
    -_vehicleList: Signal<Vehicle[]>
    -_selectedVehicle: Signal<Vehicle | null>
    -_driverList: Signal<Driver[]>
    -_selectedDriver: Signal<Driver | null>
    -_deliveryList: Signal<Delivery[]>
    -_isLoading: Signal<boolean>
    -_error: Signal<string>
    +vehicleList: Signal<Vehicle[]>
    +driverList: Signal<Driver[]>
    +deliveryList: Signal<Delivery[]>
    +availableVehicles: Signal<Vehicle[]>
    +inRouteVehicles: Signal<Vehicle[]>
    +vehiclesInMaintenance: Signal<Vehicle[]>
    +availableDrivers: Signal<Driver[]>
    +assignedDrivers: Signal<Driver[]>
    +activeDeliveries: Signal<Delivery[]>
    +loadVehicles(): void
    +createVehicle(vehicle: Vehicle): void
    +updateVehicle(vehicle: Vehicle): void
    +deleteVehicle(id: string): void
    +loadDrivers(): void
    +createDriver(driver: Driver): void
    +updateDriver(driver: Driver): void
    +deleteDriver(id: string): void
    +assignDelivery(orderId, vehicleId, driverId): void
  }
}

package "fulfillment.infrastructure" #D6EAD6 {
  abstract class BaseApi {}
  abstract class BaseApiEndpoint {}

  class FulfillmentApi {
    -_vehicleEndpoint: VehicleApiEndpoint
    -_driverEndpoint: DriverApiEndpoint
    -_deliveryEndpoint: DeliveryApiEndpoint
    +getVehicles(): Observable<Vehicle[]>
    +createVehicle(vehicle): Observable<Vehicle>
    +updateVehicle(vehicle, id): Observable<Vehicle>
    +deleteVehicle(id): Observable<void>
    +getDrivers(): Observable<Driver[]>
    +createDriver(driver): Observable<Driver>
    +updateDriver(driver, id): Observable<Driver>
    +deleteDriver(id): Observable<void>
    +createDelivery(delivery): Observable<Delivery>
  }

  class VehicleApiEndpoint {
    +getVehiclesByProvider(providerId: string): Observable<Vehicle[]>
    +getAvailableVehicles(providerId: string): Observable<Vehicle[]>
  }

  class DriverApiEndpoint {
    +getDriversByProvider(providerId: string): Observable<Driver[]>
    +getAvailableDrivers(providerId: string): Observable<Driver[]>
  }

  class DeliveryApiEndpoint {
    +getDeliveriesByProvider(providerId: string): Observable<Delivery[]>
    +getDeliveryByOrder(orderId: string): Observable<Delivery>
  }

  class VehicleAssembler {
    +toEntityFromResource(resource): Vehicle
    +toResourceFromEntity(entity): VehicleResource
    +toEntitiesFromResponse(response): Vehicle[]
  }

  class DriverAssembler {
    +toEntityFromResource(resource): Driver
    +toResourceFromEntity(entity): DriverResource
    +toEntitiesFromResponse(response): Driver[]
  }

  class DeliveryAssembler {
    +toEntityFromResource(resource): Delivery
    +toResourceFromEntity(entity): DeliveryResource
    +toEntitiesFromResponse(response): Delivery[]
  }

  FulfillmentApi -up-|> BaseApi
  VehicleApiEndpoint -up-|> BaseApiEndpoint
  DriverApiEndpoint -up-|> BaseApiEndpoint
  DeliveryApiEndpoint -up-|> BaseApiEndpoint
  VehicleApiEndpoint *-- VehicleAssembler
  DriverApiEndpoint *-- DriverAssembler
  DeliveryApiEndpoint *-- DeliveryAssembler
  FulfillmentApi *-- VehicleApiEndpoint
  FulfillmentApi *-- DriverApiEndpoint
  FulfillmentApi *-- DeliveryApiEndpoint
}

package "fulfillment.presentation" #F7E6D6 {
  class DispatchDashboardComponent {
    -store: FulfillmentStore
  }
  class VehicleListComponent {
    -store: FulfillmentStore
  }
  class VehicleFormComponent {
    -store: FulfillmentStore
    +form: FormGroup
    +isEditMode: boolean
  }
  class DriverListComponent {
    -store: FulfillmentStore
  }
  class DriverFormComponent {
    -store: FulfillmentStore
    +form: FormGroup
    +isEditMode: boolean
  }
}

FulfillmentStore --> FulfillmentApi : injects
DispatchDashboardComponent --> FulfillmentStore : injects
VehicleListComponent --> FulfillmentStore : injects
VehicleFormComponent --> FulfillmentStore : injects
DriverListComponent --> FulfillmentStore : injects
DriverFormComponent --> FulfillmentStore : injects

@enduml
