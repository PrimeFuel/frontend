@startuml Reporting BC

skinparam backgroundColor #FAFAFA
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #555555
skinparam classHeaderBackgroundColor #2C3E50
skinparam classFontColor White
skinparam ArrowColor #2C3E50
skinparam linetype ortho

package "reporting.domain" #D6E4F0 {
  interface BaseEntity {
    +id: string
  }

  class ClientPortfolio {
    +id: string
    +providerId: string
    +companyName: string
    +sector: string
    +totalVolume: number
    +totalCost: number
    +activeOrders: number
    +lastActiveDate: string
    +status: string
    +createdAt: string
  }

  class SalesMetrics {
    +id: string
    +providerId: string
    +totalRevenue: number
    +revenueGrowthRate: number
    +totalClients: number
    +activeOrders: number
    +period: string
    +createdAt: string
  }

  class FulfillmentMetrics {
    +id: string
    +providerId: string
    +avgFulfillmentRate: number
    +avgLeadTime: number
    +totalDeliveries: number
    +onTimeDeliveries: number
    +period: string
    +createdAt: string
  }

  class SectorDistribution {
    +id: string
    +providerId: string
    +sector: string
    +volumePercentage: number
    +totalVolume: number
    +period: string
    +createdAt: string
  }

  ClientPortfolio .up.|> BaseEntity
  SalesMetrics .up.|> BaseEntity
  FulfillmentMetrics .up.|> BaseEntity
  SectorDistribution .up.|> BaseEntity
}

package "reporting.application" #FFF9E6 {
  class ReportingStore {
    -_allClients: Signal<ClientPortfolio[]>
    -_clientList: Signal<ClientPortfolio[]>
    -_fulfillmentMetrics: Signal<FulfillmentMetrics | null>
    -_isLoading: Signal<boolean>
    -_error: Signal<string>
    +clientList: Signal<ClientPortfolio[]>
    +fulfillmentMetrics: Signal<FulfillmentMetrics | null>
    +totalRevenue: Signal<number>
    +totalClients: Signal<number>
    +totalActiveOrders: Signal<number>
    +revenueGrowthRate: Signal<number>
    +salesMetrics: Signal<object | null>
    +loadClients(providerId: string): void
    +filterBySector(sector: string): void
    +loadFulfillmentMetrics(providerId: string): void
    +loadSalesMetrics(providerId: string): void
    +loadSectorDistribution(providerId: string): void
  }
}

package "reporting.infrastructure" #D6EAD6 {
  abstract class BaseApi {}
  abstract class BaseApiEndpoint {}
  abstract class ErrorHandlingEnabledBaseType {}

  class ReportingApi {
    -_clientPortfolioEndpoint: ClientPortfolioApiEndpoint
    -_metricsEndpoint: MetricsApiEndpoint
    +getClients(providerId): Observable<ClientPortfolio[]>
    +getSalesMetrics(providerId): Observable<SalesMetrics>
    +getFulfillmentMetrics(providerId): Observable<FulfillmentMetrics>
    +getSectorDistributions(providerId): Observable<SectorDistribution[]>
  }

  class ClientPortfolioApiEndpoint {
    +getByProvider(providerId: string): Observable<ClientPortfolio[]>
  }

  class MetricsApiEndpoint {
    -assembler: MetricsAssembler
    +getSalesMetrics(providerId): Observable<SalesMetrics>
    +getFulfillmentMetrics(providerId): Observable<FulfillmentMetrics>
    +getSectorDistributions(providerId): Observable<SectorDistribution[]>
  }

  class ClientPortfolioAssembler {
    +toEntityFromResource(resource): ClientPortfolio
    +toResourceFromEntity(entity): ClientPortfolioResource
    +toEntitiesFromResponse(response): ClientPortfolio[]
  }

  class MetricsAssembler {
    +toSalesMetrics(resource): SalesMetrics
    +toFulfillmentMetrics(resource): FulfillmentMetrics
    +toSectorDistribution(resource): SectorDistribution
  }

  ReportingApi -up-|> BaseApi
  ClientPortfolioApiEndpoint -up-|> BaseApiEndpoint
  MetricsApiEndpoint -up-|> ErrorHandlingEnabledBaseType
  ClientPortfolioApiEndpoint *-- ClientPortfolioAssembler
  MetricsApiEndpoint *-- MetricsAssembler
  ReportingApi *-- ClientPortfolioApiEndpoint
  ReportingApi *-- MetricsApiEndpoint
}

package "reporting.presentation" #F7E6D6 {
  class SupplierDashboardComponent {
    -store: ReportingStore
    +ngOnInit(): void
    +ngOnDestroy(): void
  }
  class ClientPortfolioComponent {
    -store: ReportingStore
    +selectedSector: string
  }
}

ReportingStore --> ReportingApi : injects
SupplierDashboardComponent --> ReportingStore : injects
ClientPortfolioComponent --> ReportingStore : injects

@enduml
